# Copy to .env and fill in. Never commit .env.

# Dev Dashboard → Agents → Agent identities → your identity → API credentials
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Public base URL of this service. Must be reachable by Shopify stores because
# they fetch our agent profile from  ${PUBLIC_BASE_URL}/.well-known/ucp
# (use a tunnel such as cloudflared/ngrok in development).
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# Optional: override where the agent profile is hosted (any public URL serving public/agent-profile.json)
# AGENT_PROFILE_URL=

# Redirect URL registered on the agent identity in Dev Dashboard (Redirect URLs).
# Defaults to ${PUBLIC_BASE_URL}/auth/shop/callback
# SHOP_REDIRECT_URI=

# Scopes requested when a customer signs in with Shop (space separated)
SHOP_SCOPES="openid email phone dev.ucp.shopping.checkout:manage dev.ucp.shopping.catalog.search:read"

# 32-byte key (base64) used to encrypt tokens and pay links at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Comma-separated API keys for partner agents calling /mcp and /api (name:key pairs)
# e.g. PARTNER_API_KEYS="internal:abc123,acme-agent:def456"
PARTNER_API_KEYS=

DB_PATH=data/ucp.db

# Shop MCP (order tracking across all Shopify stores). Leave unset to use Shop's public CLI client,
# which Shop allows for PROTOTYPING ONLY. For production: create a Shop app in Dev Dashboard
# (shop_app:oauth), ask Shopify to enable it for the personal_agent scope + https://mcp.shop.com.
# SHOP_MCP_CLIENT_ID=
# SHOP_MCP_CLIENT_SECRET=
